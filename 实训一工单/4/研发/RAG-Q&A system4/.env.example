APP_NAME=PDF Document Q&A System
APP_ENV=development
API_PREFIX=/api

SOURCE_PDF_DIR=data/source
SOURCE_PDF_PATH=data/source/sample.pdf
FEEDBACK_STORE_PATH=data/processed/feedback.jsonl
MILVUS_STATE_PATH=data/processed/milvus_state.json

DEFAULT_TOP_K=8
MAX_CHUNK_LENGTH=4000
TABLE_CHUNK_LENGTH=1800

# Answer generation model
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# Query understanding model
QUERY_UNDERSTANDING_MODE=online
QUERY_UNDERSTANDING_API_KEY=
QUERY_UNDERSTANDING_BASE_URL=
QUERY_UNDERSTANDING_MODEL=
QUERY_UNDERSTANDING_TIMEOUT_SECONDS=15
QUERY_UNDERSTANDING_TEMPERATURE=0.1
QUERY_UNDERSTANDING_FALLBACK_ENABLED=true
QUERY_UNDERSTANDING_LOCAL_FIRST_ENABLED=true

# Retriever type:
# keyword      keyword only
# milvus       vector only
# hybrid_rrf   keyword + vector + RRF rerank
RETRIEVER_TYPE=hybrid_rrf

# Embedding model
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=E:\Role_playing system\Role_playing system\models\bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_qna_chunks
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=1024
MILVUS_SEARCH_NPROBE=16
RRF_K=60

# Optional reranker
RERANKER_ENABLED=true
RERANKER_MODEL_PATH=C:\Users\26332\.cache\modelscope\hub\models\BAAI\bge-reranker-base\bge-reranker-base\bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=512
RERANKER_TOP_N=8

# Session storage
SESSION_STORE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_STORE_KEY_PREFIX=rag:qna:session:
SESSION_STORE_TTL_SECONDS=86400

# Notes:
# 1. Retrieval warmup runs in background after startup.
# 2. Warmup currently focuses on the selected PDF first.
