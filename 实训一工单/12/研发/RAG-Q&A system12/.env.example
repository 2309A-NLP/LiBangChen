APP_NAME=PDF Document Q&A System
APP_ENV=development
API_PREFIX=/api

SOURCE_PDF_DIR=data/source
SOURCE_PDF_PATH=data/source/sample.pdf
FEEDBACK_STORE_PATH=data/processed/feedback.jsonl
DOCUMENT_CACHE_PATH=data/processed/document_cache.json
MILVUS_STATE_PATH=data/processed/milvus_state.json

# PDF parser: pypdf / doubao / auto
# doubao reuses LLM_API_KEY, LLM_BASE_URL, and LLM_MODEL.
PDF_PARSER_PROVIDER=pypdf

DEFAULT_TOP_K=8
MAX_CHUNK_LENGTH=4000
TABLE_CHUNK_LENGTH=1800

# Answer generation model
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# Query understanding model
QUERY_UNDERSTANDING_MODE=online
QUERY_UNDERSTANDING_API_KEY=
QUERY_UNDERSTANDING_BASE_URL=
QUERY_UNDERSTANDING_MODEL=
QUERY_UNDERSTANDING_TIMEOUT_SECONDS=15
QUERY_UNDERSTANDING_TEMPERATURE=0.1
QUERY_UNDERSTANDING_FALLBACK_ENABLED=true
QUERY_UNDERSTANDING_LOCAL_FIRST_ENABLED=true

# Retriever type:
# keyword      keyword only
# milvus       vector only
# retriever: keyword / fulltext / vector / milvus / hybrid
RETRIEVER_TYPE=hybrid
FULLTEXT_DEFAULT_OPERATOR=smart
FULLTEXT_TITLE_WEIGHT=2.4
FULLTEXT_SUMMARY_WEIGHT=1.4
FULLTEXT_BODY_WEIGHT=1.0
FULLTEXT_FUZZY_MAX_DISTANCE=1
HYBRID_TEXT_RETRIEVER=fulltext
HYBRID_FUSION_STRATEGY=rrf
HYBRID_FULLTEXT_WEIGHT=0.45
HYBRID_VECTOR_WEIGHT=0.55
HYBRID_CANDIDATE_MULTIPLIER=5
HYBRID_VOTE_MIN_AGREEMENT=1

# Embedding model
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=C:\Users\26332\.cache\modelscope\hub\models\BAAI\bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_qna_chunks
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=1024
MILVUS_SEARCH_NPROBE=16
RRF_K=60

# Optional reranker
RERANKER_ENABLED=true
RERANKER_TYPES=cross_encoder
RERANKER_MODEL_PATH=C:\Users\26332\.cache\modelscope\hub\models\BAAI\bge-reranker-base\bge-reranker-base\bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=512
RERANKER_TOP_N=8
RERANKER_LLM_API_KEY=
RERANKER_LLM_BASE_URL=
RERANKER_LLM_MODEL=
RERANKER_LLM_TIMEOUT_SECONDS=15
RERANKER_FEEDBACK_POSITIVE_RATING=4

# Session storage
SESSION_STORE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_STORE_KEY_PREFIX=rag:qna:session:
SESSION_STORE_TTL_SECONDS=86400

# Notes:
# 1. Retrieval warmup runs in background after startup.
# 2. Warmup currently focuses on the selected PDF first.
LIGHTRAG_BASE_URL=http://localhost:9621
LIGHTRAG_WORKING_DIR=./data/lightrag
LIGHTRAG_EMBEDDING_MODEL_PATH=BAAI/bge-m3
LIGHTRAG_DEFAULT_MODE=mix
LIGHTRAG_TIMEOUT=300
LIGHTRAG_TOP_K=20
LIGHTRAG_MIN_SCORE=0.3
LIGHTRAG_MAX_PARALLEL_INSERT=4
LIGHTRAG_INSERT_RETRY=3
