# LightRAG Server Configuration
# LLM: Ollama (qwen2.5:7b)
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b
MAX_ASYNC=4
MAX_PARALLEL_INSERT=4

# Embedding: OpenAI-compatible (local bge-m3 server)
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://localhost:9622/v1
EMBEDDING_BINDING_API_KEY=not-needed
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Storage
WORKING_DIR=./data/lightrag

# Optional
LIGHTRAG_API_KEY=
