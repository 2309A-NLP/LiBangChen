APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_TRUSTED_HOSTS=*
PUBLIC_BASE_URL=
CLOUDFLARE_TUNNEL_TOKEN=
LOW_MEMORY_MODE=true
APP_CORS_ORIGINS=
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_HOURS=168
ADMIN_API_KEY=
LOGIN_RATE_LIMIT_PER_MINUTE=20
REGISTER_RATE_LIMIT_PER_HOUR=10
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_IP_RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=20
ANALYZE_RATE_LIMIT_PER_MINUTE=20

# 公网分享建议：
# 1. 临时分享可运行 `python run.py share`
# 2. 如需固定公网地址，请配置：
# PUBLIC_BASE_URL=https://chat.example.com
# CLOUDFLARE_TUNNEL_TOKEN=你的 Cloudflare Tunnel Token
# 3. 如需限制 Host 头，可改成：
# APP_TRUSTED_HOSTS=localhost,127.0.0.1,*.trycloudflare.com

# 大模型生成配置。
# 本地 Ollama 示例：
# OPENAI_API_KEY=
# OPENAI_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
#
# 在线 OpenAI / OpenAI 兼容服务示例：
# OPENAI_API_KEY=你的在线大模型 API Key
# OPENAI_API_BASE=https://api.openai.com/v1
# LLM_MODEL=你的模型名称
OPENAI_API_KEY=
OPENAI_API_BASE=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

KNOWLEDGE_SYNC_ENABLED=true
KNOWLEDGE_SYNC_INTERVAL_MINUTES=10080
KNOWLEDGE_SYNC_RUN_ON_STARTUP=false
KNOWLEDGE_SOURCE_ROOT_DIR=./knowledge_sources
KNOWLEDGE_SYNC_INCLUDE_SEED_DATA=true

# 数据库后端。默认 sqlite，适合直接部署到单机服务器。
DATABASE_BACKEND=sqlite
SQLITE_DATABASE_URL=sqlite:///./roleplay_system.db

# MySQL 业务数据库。仅当 DATABASE_BACKEND=mysql 时使用。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=roleplay_system

# 如需完全自定义 SQLAlchemy 连接串，可直接设置 DATABASE_URL。
# 例如：
# DATABASE_URL=sqlite:///./roleplay_system.db
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/roleplay_system

# Milvus 向量库。虚拟机里运行 Milvus 时，把 MILVUS_HOST 改成虚拟机 IP。
ENABLE_MILVUS=true
MILVUS_HOST=你的虚拟机IP
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=knowledge_base
MILVUS_USER_COLLECTION_NAME=user_documents
# 如果你的 Milvus 使用 URI / 鉴权 / HTTPS，再按需打开下面配置。
# MILVUS_URI=http://你的虚拟机IP:19530
# MILVUS_USER=
# MILVUS_PASSWORD=
# MILVUS_TOKEN=
# MILVUS_DB_NAME=
# MILVUS_SECURE=false
# MILVUS_TIMEOUT=10

# 本地 embedding 模型路径。维度需要保持 1024，本项目默认按 bge-m3 建表。
EMBEDDING_MODEL_PATH=E:\角色扮演系统\角色扮演系统\models\bge-m3

# 混合检索和重排配置。Milvus 不可用时仍会走 BM25 + 本地向量召回。
ENABLE_HYBRID_RETRIEVAL=true
HYBRID_RRF_K=60
HYBRID_CANDIDATE_MULTIPLIER=4
BM25_K1=1.5
BM25_B=0.75
MILVUS_RECONNECT_INTERVAL_SECONDS=120

# 可选的 BGE rerank 模型；未安装时会自动跳过重排。
ENABLE_RERANK=true
RERANK_MODEL_PATH=E:\角色扮演系统\角色扮演系统\models\bge-reranker-v2-m3
RERANK_CANDIDATE_LIMIT=4
ENABLE_RERANK=false
HYBRID_CANDIDATE_MULTIPLIER=2
